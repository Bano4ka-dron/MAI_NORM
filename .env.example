# Скопируйте этот файл в .env и подставьте свой токен.
#
# Токен нужен для доступа к Hugging Face Space "Kwai-Kolors/Kolors-Virtual-Try-On",
# который выполняет виртуальную примерку.
#
# Получить токен: https://huggingface.co/settings/tokens
# Права: достаточно роли "Read".
#
# Приложение работает и без токена, но Space может ограничивать
# анонимные запросы (rate limit) или требовать авторизацию.

HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
